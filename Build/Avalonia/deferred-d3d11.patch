--- /dev/null
+++ b/src/Windows/Avalonia.Win32/IWin32AngleProgramCache.cs
@@ -0,0 +1,14 @@
+using System;
+
+namespace Avalonia.Win32;
+
+/// <summary>Storage for opaque ANGLE shader-program binaries. ANGLE supplies and validates compatibility keys.</summary>
+public interface IWin32AngleProgramCache
+{
+    /// <summary>Returns an immutable cached binary, or empty memory on a miss. Called from native rendering threads.</summary>
+    ReadOnlyMemory<byte> Load(ReadOnlySpan<byte> key);
+
+    /// <summary>Copies a newly compiled binary into storage. Native memory is only valid during this call.</summary>
+    /// <remarks>Do not perform file I/O or call back into EGL here; defer persistence until after the first frame.</remarks>
+    void Store(ReadOnlySpan<byte> key, ReadOnlySpan<byte> binary);
+}
diff --git a/src/Windows/Avalonia.Win32/IWin32FirstFrameFeature.cs b/src/Windows/Avalonia.Win32/IWin32FirstFrameFeature.cs
new file mode 100644
