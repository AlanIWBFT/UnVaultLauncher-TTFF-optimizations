diff --git a/src/Windows/Avalonia.Win32/OpenGl/Angle/AngleEglProgramCache.cs b/src/Windows/Avalonia.Win32/OpenGl/Angle/AngleEglProgramCache.cs
new file mode 100644
index 0000000..1832aff
--- /dev/null
+++ b/src/Windows/Avalonia.Win32/OpenGl/Angle/AngleEglProgramCache.cs
@@ -0,0 +1,92 @@
+using System;
+using System.Runtime.InteropServices;
+using Avalonia.OpenGL.Egl;
+using Avalonia.Win32.DirectX;
+using MicroCom.Runtime;
+using static Avalonia.OpenGL.Egl.EglConsts;
+
+namespace Avalonia.Win32.OpenGl.Angle;
+
+internal sealed unsafe class AngleEglProgramCache
+{
+    [UnmanagedFunctionPointer(CallingConvention.StdCall)]
+    private delegate void SetBlob(IntPtr key, nint keySize, IntPtr value, nint valueSize);
+    [UnmanagedFunctionPointer(CallingConvention.StdCall)]
+    private delegate nint GetBlob(IntPtr key, nint keySize, IntPtr value, nint valueSize);
+
+    private readonly IWin32AngleProgramCache _cache;
+    private readonly SetBlob _set;
+    private readonly GetBlob _get;
+    private bool _failed;
+
+    private AngleEglProgramCache(IWin32AngleProgramCache cache)
+    {
+        _cache = cache;
+        _set = Store;
+        _get = Load;
+    }
+
+    public static AngleEglProgramCache? TryAttach(EglInterface egl, IntPtr display, ID3D11Device device)
+    {
+        var cache = AvaloniaLocator.Current.GetService<Win32PlatformOptions>()?.WarpProgramCache;
+        if (cache == null)
+            return null;
+        try
+        {
+            using var dxgiDevice = device.QueryInterface<IDXGIDevice>();
+            using var adapter = dxgiDevice.Adapter;
+            using var adapter1 = adapter.QueryInterface<IDXGIAdapter1>();
+            // DXGI_ADAPTER_FLAG_SOFTWARE: fixed WARP mode is covered too, but hardware takeover is not.
+            if ((adapter1.Desc1.Flags & 2) == 0 ||
+                egl.QueryString(display, EGL_EXTENSIONS)?.Contains("EGL_ANDROID_blob_cache") != true)
+                return null;
+            IntPtr address;
+            fixed (byte* name = "eglSetBlobCacheFuncsANDROID\0"u8)
+                address = egl.GetProcAddress((IntPtr)name);
+            if (address == IntPtr.Zero)
+                return null;
+            var binding = new AngleEglProgramCache(cache);
+            ((delegate* unmanaged[Stdcall]<IntPtr, IntPtr, IntPtr, void>)address)(display,
+                Marshal.GetFunctionPointerForDelegate(binding._set), Marshal.GetFunctionPointerForDelegate(binding._get));
+            return binding;
+        }
+        catch (Exception)
+        {
+            // Caching is optional; an unavailable extension/provider must not disable rendering.
+            return null;
+        }
+    }
+
+    private nint Load(IntPtr key, nint keySize, IntPtr value, nint valueSize)
+    {
+        if (_failed || keySize <= 0 || keySize > 128 || valueSize < 0)
+            return 0;
+        try
+        {
+            var binary = _cache.Load(new ReadOnlySpan<byte>((void*)key, (int)keySize));
+            if (value != IntPtr.Zero && valueSize >= binary.Length)
+                binary.Span.CopyTo(new Span<byte>((void*)value, binary.Length));
+            // EGL first queries the size, then requests a copy. An undersized destination is not written.
+            return binary.Length;
+        }
+        catch (Exception)
+        {
+            _failed = true;
+            return 0;
+        }
+    }
+
+    private void Store(IntPtr key, nint keySize, IntPtr value, nint valueSize)
+    {
+        if (_failed || keySize <= 0 || keySize > 128 || valueSize <= 0 || valueSize > int.MaxValue)
+            return;
+        try
+        {
+            _cache.Store(new ReadOnlySpan<byte>((void*)key, (int)keySize), new ReadOnlySpan<byte>((void*)value, (int)valueSize));
+        }
+        catch (Exception)
+        {
+            _failed = true;
+        }
+    }
+}
