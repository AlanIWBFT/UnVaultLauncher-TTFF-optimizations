--- /dev/null
+++ b/src/Windows/Avalonia.Win32/IWin32FirstFrameFeature.cs
@@ -0,0 +1,20 @@
+using System;
+using System.Threading.Tasks;
+
+namespace Avalonia.Win32;
+
+/// <summary>Per-window startup synchronization provided by the Windows.UI.Composition backend.</summary>
+public interface IWin32FirstFrameFeature
+{
+    /// <summary>
+    /// Completes after the native composition commit containing this window's first successful draw.
+    /// This is a submission fence, not a physical display scan-out notification. Canceled if the window closes first.
+    /// </summary>
+    Task FirstFrameCommitted { get; }
+
+    /// <summary>
+    /// Prevent deferred hardware takeover until the returned lease is disposed. Acquire before showing the window,
+    /// then release after revealing it. Other windows cannot bypass an active lease.
+    /// </summary>
+    IDisposable DeferHardwareSwitch();
+}
