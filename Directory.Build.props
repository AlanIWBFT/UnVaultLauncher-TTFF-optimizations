<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The product version, shared by every project: exe file properties, the app's header, the CLI's version option. -->
    <Version>0.7.1</Version>
    <Copyright>(c) 2026 Dmitry Karpukhin</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- All build output (bin, obj, publish) goes to Bin\ next to this file, keeping Source\ and Tests\ free of it. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)Bin</ArtifactsPath>
    <!-- Generated by Build/Avalonia/BuildPatchedAvalonia.cs before restoring the app. -->
    <RestoreAdditionalProjectSources Condition="Exists('$(MSBuildThisFileDirectory)Bin/packages')">$(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)Bin/packages</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
