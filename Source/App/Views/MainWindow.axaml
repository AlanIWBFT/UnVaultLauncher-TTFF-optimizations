<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:UnVault.App"
        xmlns:vm="using:UnVault.App.ViewModels"
        xmlns:views="using:UnVault.App.Views"
        x:Class="UnVault.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/unvault.ico"
        Title="UnVault Launcher"
        Width="1100" Height="760" MinWidth="760" MinHeight="520"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Image Source="/Assets/unvault-logo.png" Width="28" Height="28" RenderOptions.BitmapInterpolationMode="HighQuality" />
                            <TextBlock Text="UnVault" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="Launcher" FontSize="18" Classes="muted" VerticalAlignment="Center" Margin="-4,0,0,0" />
                            <!-- The version opens About; a pill beside it tells when a newer release is out -->
                            <Button Classes="subtle" Padding="4,1" Margin="-6,3,0,0" VerticalAlignment="Center" Command="{Binding OpenAboutCommand}"
                                    ToolTip.Tip="{x:Static s:Strings.AboutUnVaultLauncher}" AutomationProperties.Name="{x:Static s:Strings.AboutUnVaultLauncher}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding VersionText}" Classes="muted small" VerticalAlignment="Center" />
                                    <Border Classes="chip warning" IsVisible="{Binding HasAppUpdate}">
                                        <TextBlock Text="{x:Static s:Strings.UpdateAvailable}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="subtle" Command="{Binding RefreshCommand}" ToolTip.Tip="{x:Static s:Strings.Refresh}" AutomationProperties.Name="{x:Static s:Strings.Refresh}" IsEnabled="{Binding !IsLoading}" Padding="8">
                            <!-- A clockwise arrow: a ring around (8,8) open at the top right, ending in an arrowhead -->
                            <PathIcon Width="15" Height="15"
                                      Data="F1 M13.95,8 A5.95,5.95 0 1 1 12.207,3.793 L11.217,4.783 A4.55,4.55 0 1 0 12.55,8 A0.7,0.7 0 0 1 13.95,8 Z M13.4,6 L9.6,5.7 L13.1,2.2 Z" />
                        </Button>
                        <Button Classes="subtle" Content="{x:Static s:Strings.Settings}" Command="{Binding OpenSettingsCommand}" />
                        <Button Content="{x:Static s:Strings.SignIn}" Classes="accent" Command="{Binding SignInCommand}" IsVisible="{Binding IsSignedOut}" />
                        <Button Classes="subtle" IsVisible="{Binding IsSignedIn}" Padding="6,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Avatar: a grey circle with a head and shoulders cut out; one shape, so no edges overlap.
                                     The shoulders stop inside the circle, leaving a grey band under them. -->
                                <Path Width="28" Height="28" Fill="{StaticResource MutedTextBrush}">
                                    <Path.Data>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <EllipseGeometry Rect="0,0,28,28" />
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <GeometryGroup FillRule="NonZero">
                                                    <EllipseGeometry Center="14,11.3" RadiusX="4.7" RadiusY="4.7" />
                                                    <CombinedGeometry GeometryCombineMode="Intersect">
                                                        <CombinedGeometry.Geometry1>
                                                            <EllipseGeometry Center="14,25.2" RadiusX="9" RadiusY="7.5" />
                                                        </CombinedGeometry.Geometry1>
                                                        <CombinedGeometry.Geometry2>
                                                            <EllipseGeometry Rect="2.5,2.5,23,23" />
                                                        </CombinedGeometry.Geometry2>
                                                    </CombinedGeometry>
                                                </GeometryGroup>
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Path.Data>
                                </Path>
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{x:Static s:Strings.SignOut}" Command="{Binding SignOutCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tabs, standing on a line across the page, and the open page's tools at the other end. A tab's dot: yellow
                 when something there wants a look (an engine update, a Library item update, a failed operation); on
                 Downloads, blue and pulsing while anything runs, so work shows in one place. -->
            <Border Grid.Row="1" Margin="24,14,24,0" MaxWidth="{StaticResource PageMaxWidth}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="tab" Classes.active="{Binding IsEnginesTab}" Command="{Binding ShowEnginesCommand}" ToolTip.Tip="{Binding EngineUpdatesText}">
                            <Panel>
                                <TextBlock Text="{x:Static s:Strings.Engines}" />
                                <views:TabMark NeedsAttention="{Binding HasEngineUpdates}" />
                            </Panel>
                        </Button>
                        <Button Classes="tab" Classes.active="{Binding IsFabTab}" Command="{Binding ShowFabCommand}" ToolTip.Tip="{Binding LibraryUpdatesText}">
                            <Panel>
                                <TextBlock Text="{x:Static s:Strings.Library}" />
                                <views:TabMark NeedsAttention="{Binding HasLibraryUpdates}" />
                            </Panel>
                        </Button>
                        <Button Classes="tab" Classes.active="{Binding IsDownloadsTab}" Command="{Binding ShowDownloadsCommand}" ToolTip.Tip="{Binding FailedOperationsText}">
                            <Panel>
                                <TextBlock Text="{x:Static s:Strings.Downloads}" />
                                <views:TabMark IsWorking="{Binding HasRunningOperations}" NeedsAttention="{Binding HasFailedOperations}" />
                            </Panel>
                        </Button>
                    </StackPanel>

                    <!-- The open page refreshing -->
                    <DockPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
                        <DockPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsEnginesTab" />
                                <Binding Path="IsLoading" />
                            </MultiBinding>
                        </DockPanel.IsVisible>
                        <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="120" />
                        <TextBlock Text="{Binding LoadingText}" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
                        <DockPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsFabTab" />
                                <Binding Path="Fab.IsLoading" />
                            </MultiBinding>
                        </DockPanel.IsVisible>
                        <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="120" />
                        <TextBlock Text="{Binding Fab.LoadingText}" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Panel Grid.Column="2" VerticalAlignment="Center">
                        <Button Classes="accent" Command="{Binding InstallEngineCommand}" Padding="10" IsVisible="{Binding IsEnginesTab}"
                                ToolTip.Tip="{x:Static s:Strings.InstallEngine}" AutomationProperties.Name="{x:Static s:Strings.InstallEngine}">
                            <!-- A bold plus: two bars crossing in the middle of a 16 px grid -->
                            <PathIcon Width="14" Height="14" Data="M6.7,2 H9.3 V6.7 H14 V9.3 H9.3 V14 H6.7 V9.3 H2 V6.7 H6.7 Z" />
                        </Button>
                        <TextBlock Text="{Binding Fab.Summary}" Classes="muted" IsVisible="{Binding IsFabTab}" />
                    </Panel>
                </Grid>
            </Border>

            <!-- A problem worth telling about (failed sign-in, Epic unreachable…), above any page -->
            <Border Grid.Row="2" Classes="banner warning" Margin="24,16,24,0" MaxWidth="{StaticResource PageMaxWidth}" IsVisible="{Binding HasNotice}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="subtle" Content="✕" Command="{Binding DismissNoticeCommand}"
                            ToolTip.Tip="{x:Static s:Strings.Dismiss}" AutomationProperties.Name="{x:Static s:Strings.Dismiss}" />
                </Grid>
            </Border>

            <!-- Engines -->
            <ScrollViewer Grid.Row="3" IsVisible="{Binding IsEnginesTab}">
                <StackPanel Margin="24,20,24,24" Spacing="12" MaxWidth="{StaticResource PageMaxWidth}">

                    <Border Classes="banner" IsVisible="{Binding IsSignedOut}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="{x:Static s:Strings.EnginesSignInBanner}" />
                            <Button Grid.Column="1" Content="{x:Static s:Strings.SignIn}" Classes="accent" Margin="12,0,0,0" Command="{Binding SignInCommand}" />
                        </Grid>
                    </Border>

                    <StackPanel IsVisible="{Binding HasNoEngines}" Margin="0,32" Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Static s:Strings.NoEngines}" FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Static s:Strings.NoEnginesHint}" Classes="muted" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Engines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:EngineCardViewModel">
                                <views:EngineCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <!-- Fab -->
            <views:FabLibraryView Grid.Row="3" DataContext="{Binding Fab}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsFabTab}" />

            <!-- Downloads: what's running or waiting to be resumed, then what's finished -->
            <ScrollViewer Grid.Row="3" IsVisible="{Binding IsDownloadsTab}">
                <!-- Less on top: the first section heading brings its own gap -->
                <StackPanel Margin="24,4,24,24" MaxWidth="{StaticResource PageMaxWidth}">
                    <TextBlock Text="{x:Static s:Strings.SectionInProgress}" Classes="section" />
                    <TextBlock Text="{x:Static s:Strings.NothingInProgress}" Classes="muted" IsVisible="{Binding !HasOperations}" />
                    <ItemsControl ItemsSource="{Binding Operations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:OperationViewModel">
                                <Border Classes="card">
                                    <views:OperationView />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                        <TextBlock Text="{x:Static s:Strings.SectionHistory}" Classes="section" VerticalAlignment="Bottom" />
                        <Button Grid.Column="1" Classes="subtle" Content="{x:Static s:Strings.ClearHistory}" Command="{Binding ClearHistoryCommand}"
                                IsVisible="{Binding HasHistory}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                    </Grid>
                    <TextBlock Text="{x:Static s:Strings.NoHistory}" Classes="muted" IsVisible="{Binding !HasHistory}" />
                    <!-- Grouped by day; one panel of rows per day rather than a card each, as the history can be long -->
                    <ItemsControl ItemsSource="{Binding HistoryDays}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:HistoryDayViewModel">
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}" Classes="muted small" FontWeight="SemiBold" Margin="2,10,0,6" />
                                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="10">
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.Styles>
                                                <Style Selector="ContentPresenter:nth-child(n+2) > Border.historyRow">
                                                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                </Style>
                                            </ItemsControl.Styles>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:HistoryEntryViewModel">
                                                    <Border Classes="historyRow" BorderBrush="{StaticResource CardBorderBrush}" Padding="16,12">
                                                        <views:HistoryEntryView />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Dialog overlay: Tab goes round the dialog's controls and never reaches the page behind -->
        <Border Background="{StaticResource OverlayBrush}" IsVisible="{Binding HasDialog}" KeyboardNavigation.TabNavigation="Cycle">
            <Panel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <!-- Takes the focus when a dialog opens (see FocusDialog), but isn't a stop for Tab itself. Disabled under a
                     question, so its own Enter and Esc buttons don't answer for the question's. -->
                <ContentControl x:Name="DialogHost" Content="{Binding Dialog}"
                                Focusable="True" KeyboardNavigation.IsTabStop="False" IsEnabled="{Binding !HasPrompt}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="vm:ComponentPickerViewModel">
                            <views:ComponentPickerView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:SettingsViewModel">
                            <views:SettingsView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:FabActionViewModel">
                            <views:FabActionView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:ConfirmViewModel">
                            <views:ConfirmView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:AboutViewModel">
                            <views:AboutView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:InstalledPluginsViewModel">
                            <views:InstalledPluginsView />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
                <!-- Under a question, the dialog is dimmed as the page is under it; the page isn't dimmed a second time -->
                <Border Background="{StaticResource OverlayBrush}" CornerRadius="10" IsVisible="{Binding HasPrompt}" />
            </Panel>
        </Border>

        <!-- A question over the dialog. Clear, but it still takes the clicks, so nothing behind it can be used meanwhile. -->
        <Border Background="Transparent" IsVisible="{Binding HasPrompt}" KeyboardNavigation.TabNavigation="Cycle">
            <ContentControl x:Name="PromptHost" Content="{Binding Prompt}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                            Focusable="True" KeyboardNavigation.IsTabStop="False">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:ConfirmViewModel">
                        <views:ConfirmView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>
    </Grid>
</Window>
