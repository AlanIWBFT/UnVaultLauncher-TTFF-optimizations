<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UnVault.App.Views.TabMark"
             Height="3" VerticalAlignment="Bottom" Margin="-2,0,-2,-6">
    <!-- Along the tab's bottom edge, in its padding: the negative margins keep it out of the layout, so no tab moves when it
         shows -->
    <Panel>
        <Border x:Name="AttentionLine" Classes="tabMark" />
        <ProgressBar x:Name="WorkingBar" Classes="tabMark" />
    </Panel>
</UserControl>
