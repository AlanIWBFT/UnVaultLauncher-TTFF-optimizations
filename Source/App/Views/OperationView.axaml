<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:UnVault.App"
             xmlns:vm="using:UnVault.App.ViewModels"
             x:Class="UnVault.App.Views.OperationView"
             x:DataType="vm:OperationViewModel">

    <!-- What it works on, beneath it what it does and the step it's on, then how far it is (or why it stopped) -->
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subject}" />
        <TextBlock Grid.Row="1" Text="{Binding ActionLine}" Classes="muted small" Margin="0,3,0,0" />

        <StackPanel Grid.Column="1" Grid.RowSpan="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Content="{x:Static s:Strings.Pause}" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" />
            <Button Content="{Binding RetryText}" Classes="accent" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" />
            <!-- Not to be resumed: into the history. A square as tall as the button beside it. -->
            <Button Command="{Binding MoveToHistoryCommand}" IsVisible="{Binding CanMoveToHistory}" VerticalAlignment="Stretch"
                    Width="{Binding $self.Bounds.Height}" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip.Tip="{x:Static s:Strings.MoveToHistory}" AutomationProperties.Name="{x:Static s:Strings.MoveToHistory}">
                <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" />
            </Button>
        </StackPanel>

        <ProgressBar Grid.Row="2" Margin="0,8,0,6" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" IsVisible="{Binding IsRunning}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16" Margin="0,2,0,0">
            <TextBlock Text="{Binding ProgressText}" Classes="muted small" IsVisible="{Binding IsRunning}" />
            <TextBlock Text="{Binding SpeedText}" Classes="muted small" IsVisible="{Binding IsRunning}" />
            <TextBlock Text="{Binding Message}" Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding IsPausedOrWaiting}" />
            <TextBlock Text="{Binding Message}" Classes="small" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" IsVisible="{Binding IsFailed}" />
        </StackPanel>
    </Grid>
</UserControl>
