<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:UnVault.App"
             xmlns:vm="using:UnVault.App.ViewModels"
             xmlns:views="using:UnVault.App.Views"
             x:Class="UnVault.App.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">

    <UserControl.Styles>
        <!-- A group's heading: its name and count, a button that folds it. No box under the pointer, as other buttons have:
             the whole heading lights up instead, its name from a soft white, its arrow and count from grey. -->
        <Style Selector="Button.groupHeading">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="-6,0,0,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.groupHeading:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.groupHeading:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Before the light-ups below: of two styles that match, the later one wins -->
        <Style Selector="Path.chevron">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stroke" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.groupHeading TextBlock.title">
            <Setter Property="Foreground" Value="#D0D0D0" />
        </Style>
        <Style Selector="Button.groupHeading TextBlock.count">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.groupHeading:pointerover TextBlock.title">
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.groupHeading:pointerover Path.chevron">
            <Setter Property="Stroke" Value="{StaticResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.groupHeading:pointerover TextBlock.count">
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- The search box, then the projects: two columns, one when the window is narrow. Loading and the count are on the tab row. -->
    <Grid RowDefinitions="Auto,*">

        <TextBox Margin="24,20,24,0" MaxWidth="{StaticResource PageMaxWidth}" Text="{Binding SearchText}" PlaceholderText="{x:Static s:Strings.SearchProjects}">
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
            </TextBox.KeyBindings>
            <TextBox.InnerRightContent>
                <Button Classes="clear" Command="{Binding ClearSearchCommand}" ToolTip.Tip="{x:Static s:Strings.ClearSearchTip}" AutomationProperties.Name="{x:Static s:Strings.ClearSearch}"
                        IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.6" StrokeLineCap="Round" />
                </Button>
            </TextBox.InnerRightContent>
        </TextBox>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
            <Panel Margin="24,0,24,24" MaxWidth="{StaticResource PageMaxWidth}">
                <StackPanel IsVisible="{Binding IsEmpty}" Margin="0,32" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding EmptyText}" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyHint}" Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               IsVisible="{Binding EmptyHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <!-- The categories, each under a heading that folds it (its ⋯ renames or deletes it), then the projects in none.
                     With no categories, just the projects. -->
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ProjectGroupViewModel">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8" IsVisible="{Binding HasHeading}">
                                    <Button Classes="groupHeading" Command="{Binding ToggleFoldCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Turned with the projects' slide: down when they show, right when folded away -->
                                            <Path Classes="chevron" Data="M2,4.5 L6,8.5 L10,4.5" Margin="0,0,8,0">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="{Binding #Fold.Openness, Converter={x:Static views:FoldPanel.ArrowAngle}}" />
                                                </Path.RenderTransform>
                                            </Path>
                                            <TextBlock Classes="title" Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Classes="count" Text="{Binding CountText}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="subtle" Content="⋯" IsVisible="{Binding CanEdit}"
                                            ToolTip.Tip="{x:Static s:Strings.More}" AutomationProperties.Name="{x:Static s:Strings.More}">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="{x:Static s:Strings.RenameEllipsis}" Command="{Binding RenameCommand}" />
                                                <MenuItem Header="{x:Static s:Strings.DeleteEllipsis}" Command="{Binding DeleteCommand}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <!-- Its projects slide shut when folded, and open again -->
                                <views:FoldPanel x:Name="Fold" IsOpen="{Binding IsOpen}">
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{x:Static s:Strings.EmptyCategoryHint}" Classes="muted small" Margin="28,0,0,0" IsVisible="{Binding ShowsEmptyHint}" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <views:ColumnsPanel MinColumnWidth="{x:Static views:ProjectsView.MinColumnWidth}" MaxColumns="2" Spacing="12" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:ProjectCardViewModel">
                                                    <views:ProjectCardView />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </views:FoldPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
