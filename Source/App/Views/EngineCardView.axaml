<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:UnVault.App"
             xmlns:vm="using:UnVault.App.ViewModels"
             x:Class="UnVault.App.Views.EngineCardView"
             x:DataType="vm:EngineCardViewModel">

    <Border Classes="card" Padding="0">
        <!-- A card with one line of text (missing files) as tall as the others -->
        <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="72">

            <!-- The version, as the card's picture, filling its left side; a long one (4.27.2) shrinks to fit -->
            <Border Classes="versionTile" Classes.installed="{Binding IsInstalled}" AutomationProperties.Name="{Binding Title}">
                <Viewbox StretchDirection="DownOnly" Margin="9,0">
                    <TextBlock Text="{Binding ShownVersion}" FontSize="24" />
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Margin="20,16,16,16" Spacing="4" VerticalAlignment="Center">
                <!-- Where it is, then a chip only for what needs a look (an update, missing files), and while it's busy -->
                <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <TextBlock Text="{Binding Details}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Border Classes="chip compact" Classes.warning="{Binding HasUpdate}" Classes.danger="{Binding IsStale}" IsVisible="{Binding ShowsStatus}">
                        <TextBlock Text="{Binding StatusText}" />
                    </Border>
                    <Border Classes="chip compact" IsVisible="{Binding IsBusy}">
                        <TextBlock Text="{x:Static s:Strings.Working}" />
                    </Border>
                </WrapPanel>
                <TextBlock Text="{Binding OriginText}" Classes="muted small" IsVisible="{Binding OriginText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,16,0" VerticalAlignment="Center">
                <!-- An update takes Launch's place, in orange as on Library tiles; Launch is then the first thing under ⋯ -->
                <Button Content="{x:Static s:Strings.Update}" Classes="update" Command="{Binding UpdateCommand}" IsVisible="{Binding HasUpdate}" />
                <Button Content="{x:Static s:Strings.Launch}" Classes="accent" Command="{Binding LaunchCommand}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsInstalled" />
                            <Binding Path="!HasUpdate" />
                        </MultiBinding>
                    </Button.IsVisible>
                </Button>
                <Button Content="{x:Static s:Strings.InstallEllipsis}" Classes="accent" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" />
                <Button Content="⋯" IsVisible="{Binding IsInstalled}" ToolTip.Tip="{x:Static s:Strings.More}" AutomationProperties.Name="{x:Static s:Strings.More}">
                    <Button.Flyout>
                        <!-- Launch first while Update has its place; then Options (the components installed): used now and then, so not a button of its own -->
                        <MenuFlyout>
                            <MenuItem Header="{x:Static s:Strings.Launch}" Command="{Binding LaunchCommand}" IsVisible="{Binding HasUpdate}" />
                            <MenuItem Header="{x:Static s:Strings.Options}" Command="{Binding ModifyCommand}" />
                            <MenuItem Header="{x:Static s:Strings.InstalledPlugins}" Command="{Binding OpenPluginsCommand}" />
                            <MenuItem Header="{x:Static s:Strings.VerifyFiles}" Command="{Binding VerifyCommand}" />
                            <MenuItem Header="{x:Static s:Strings.InstallPrerequisites}" Command="{Binding InstallPrerequisitesCommand}"
                                      ToolTip.Tip="{x:Static s:Strings.InstallPrerequisitesTip}" />
                            <MenuItem Header="{x:Static s:Strings.ShowInFolder}" Command="{Binding OpenFolderCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
