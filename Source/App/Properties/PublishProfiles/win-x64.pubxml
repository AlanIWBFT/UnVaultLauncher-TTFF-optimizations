<Project>
  <!-- Fully linked Native AOT executable; no DLL extraction at startup.
       dotnet publish Source/App -p:PublishProfile=win-x64 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\Bin\publish\UnVault.App\static_win-x64\</PublishDir>
    <CopyExeTo>$(MSBuildProjectDirectory)\..\..\</CopyExeTo>
    <DebugType>none</DebugType>
    <!-- Native AOT's post-publish symbol copy can otherwise pick up a PDB left by a profiling build. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
</Project>
