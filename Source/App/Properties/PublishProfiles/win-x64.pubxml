<Project>
  <!-- Native AOT app and its native dependencies, archived in the repository root.
       dotnet publish Source/App -p:PublishProfile=win-x64 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\Bin\publish\UnVault.App\native_win-x64\</PublishDir>
    <PublishArchive>$(MSBuildProjectDirectory)\..\..\UnVaultLauncher-win-x64.zip</PublishArchive>
    <DebugType>none</DebugType>
    <!-- Native AOT's post-publish symbol copy can otherwise pick up a PDB left by a profiling build. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
</Project>
