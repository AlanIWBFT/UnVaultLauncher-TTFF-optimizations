<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <OutputType>WinExe</OutputType>
    <AssemblyName>UnVaultLauncher</AssemblyName>
    <RootNamespace>UnVault.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\unvault.ico</ApplicationIcon>
    <Product>UnVault Launcher</Product>
    <AssemblyTitle>UnVault Launcher</AssemblyTitle>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Strings.resx is English: English Windows uses it directly, other languages fall back to it where no translation exists. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Interface text, by name. The Strings class is generated at build time (no Visual Studio needed); a translation is a
       Strings.<language>.resx beside it, e.g. Strings.de.resx. -->
  <ItemGroup>
    <EmbeddedResource Update="Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>UnVault.App</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <InternalsVisibleTo Include="UnVault.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.3.1" />
    <PackageReference Include="StaticLink.Avalonia" Version="3.119.4.1" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive" PrivateAssets="all" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\UnVault.Core.csproj" />
  </ItemGroup>

  <!-- Native packages also carry large PDBs; keep them out of the end-user archive. -->
  <Target Name="ExcludePublishSymbols" AfterTargets="ComputeFilesToPublish" Condition="'$(DebugType)' == 'none'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <Import Project="Browser/WebView2.targets" />
  <!-- Evaluate static graphics after the SDK has loaded the publish profile's RuntimeIdentifier. -->
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="../../Build/Avalonia/StaticGraphics.targets" />
</Project>
